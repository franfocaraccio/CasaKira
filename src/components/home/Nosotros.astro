---
// Las tarjetas de "Importador directo" y "Servicio técnico propio" se mudaron
// a la sección Servicios: hablan de lo que hacemos, no de quiénes somos.
import { Picture } from 'astro:assets';
import { marcasEnProsa } from '../../data/site';
import imgFrente from '../../assets/nosotros/frente.jpg';
---
<section class="section" id="nosotros">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="section-head__top">
        <div>
          <p class="eyebrow">Quiénes somos</p>
          <h1 class="h-section" style="margin-top:var(--s-4)">Donde la experiencia se convierte en soluciones.</h1>
        </div>
        <span class="section-index">Av. Forest 888 · CABA</span>
      </div>
    </div>

    <div class="about__grid">
      <div class="about__body reveal">
        <p>
          Desde <strong>1967</strong> que en Casa Kira satisfacemos las necesidades de la industria textil,
          con una gran variedad de productos en maquinarias industriales y familiares para coser y bordar,
          hilados, repuestos y accesorios.
        </p>
        <p>
          Somos <strong>importadores directos</strong> de las principales marcas de máquinas y sus
          repuestos: {marcasEnProsa(true)}. Trabajamos con todas las máquinas industriales y
          familiares, de <strong>última generación</strong> y de alta calidad.
        </p>
        <p>
          Ofrecemos garantía de excelencia en nuestro servicio de post venta y reparación de maquinarias,
          tanto a nivel industrial como hogareño. <strong>60 años de experiencia</strong> nos permiten dar
          la mejor atención, cubriendo las necesidades puntuales de cada cliente.
        </p>
        <blockquote class="pull-quote">Casa Kira fue, es y será su respaldo de confianza.</blockquote>
      </div>

      <div class="reveal">
        <div class="photo-panel photo-panel--square photo-panel--color">
          <Picture
            src={imgFrente}
            alt="Frente del local de Casa Kira en Av. Forest 888, con el cartel de la casa y la vidriera"
            formats={['avif', 'webp']}
            widths={[320, 480, 640, 960, 1200]}
            sizes="(min-width: 1024px) 520px, calc(100vw - 3rem)"
            loading="lazy"
          />
          <span class="photo-panel__tag">Casa central · Av. Forest 888</span>
        </div>
      </div>
    </div>
  </div>
</section>
