---
import Icon from '../Icon.astro';

// Servicios propios + lo que nos permite darlos (importación directa y taller
// propio, que antes vivían en Nosotros).
const servicios = [
  { icon: 'file', t: 'Presupuestos y asesoramiento sin cargo', d: 'Diagnosticamos y cotizamos antes de intervenir la máquina.' },
  { icon: 'pin', t: 'Trabajos para el interior del país', d: 'Atendemos talleres y fábricas fuera del AMBA.' },
  { icon: 'truck', t: 'Retiros y envíos a todo el país', d: 'Coordinamos la logística de ida y vuelta.' },
  { icon: 'box', t: 'Importador directo', d: 'Sin intermediarios: mejores precios y disponibilidad real de las principales marcas.' },
  { icon: 'wrench', t: 'Servicio técnico propio', d: 'Personal especializado en nuestros talleres, capacitados en máquinas industriales y hogareñas.' },
  { icon: 'shield', t: 'Repuestos y accesorios originales', d: 'Para todas las máquinas industriales y familiares.' },
];
---
<section class="section services" id="servicios">
  <div class="tech-grid" aria-hidden="true" style="mask-image:radial-gradient(ellipse 70% 90% at 80% 50%,#000 20%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 70% 90% at 80% 50%,#000 20%,transparent 100%)"></div>
  <div class="wrap">
    <div class="services__grid">
      <div class="reveal">
        <p class="eyebrow">Servicios</p>
        <h1 class="h-section" style="margin-top:var(--s-4)">Post venta, mantenimiento y reparación.</h1>
        <p class="lead" style="margin-top:var(--s-5)">
          Nuestro personal altamente capacitado nos permite ofrecer garantía de excelencia en el servicio
          de post venta y reparación de maquinarias, tanto a nivel industrial como hogareño. Somos además
          importadores directos de repuestos de las principales marcas, indispensables para un
          mantenimiento apropiado.
        </p>

        <div class="hero__cta" style="margin-top:var(--s-6)">
          <a class="btn btn--primary" href="/contacto">Pedir presupuesto</a>
        </div>
      </div>

      <div class="services__visual reveal">
        <div class="photo-panel">
          <img src="/assets/maquinas/FotoServicios.gif" alt="Taller de servicio técnico de Casa Kira reparando máquinas de coser" width="700" height="525" loading="lazy" />
          <span class="photo-panel__tag">Taller propio · Servicio técnico</span>
        </div>
      </div>
    </div>

    <div class="feature-cards reveal" style="margin-top:var(--s-7)">
      {servicios.map((s) => (
        <article class="f-card">
          <span class="f-card__icon" aria-hidden="true"><Icon name={s.icon} size={20} /></span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
