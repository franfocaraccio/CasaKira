---
import { getCollection } from 'astro:content';
import { CATEGORIAS } from '../../data/categorias';
import { SITE, waLink } from '../../data/site';
import MachineCard from '../MachineCard.astro';

// Los paneles se renderizan estáticos (SEO + funciona sin JS); un script en la
// home cablea el cambio de pestaña. Las máquinas salen de la content collection.
const maquinas = await getCollection('maquinas');
const cats = CATEGORIAS.map((cat) => ({
  ...cat,
  modelos: maquinas
    .filter((m) => m.data.categoria === cat.id)
    .sort((a, b) => a.data.orden - b.data.orden),
}));
---
<section class="section" id="maquinas" style="background:var(--bg-alt);border-block:1px solid var(--border)">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="section-head__top">
        <div>
          <p class="eyebrow">02 — Máquinas</p>
          <h2 class="h-section" style="margin-top:var(--s-4)">Máquinas para coser y bordar.</h2>
        </div>
        <span class="section-index">7 categorías · 3 marcas</span>
      </div>
      <p class="lead">
        Elegí una categoría para ver los modelos que trabajamos, con sus características técnicas.
        Por otros tipos y modelos, consultanos sin compromiso.
      </p>
    </div>

    <div class="tabs reveal">
      <div class="tabs__scroll" role="tablist" aria-label="Categorías de máquinas" id="tablist">
        {cats.map((cat, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${cat.id}`}
            aria-controls={`panel-${cat.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {cat.nombre} <span class="tab__count">{String(cat.modelos.length).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
      <hr class="stitch" />
    </div>

    <div id="panels">
      {cats.map((cat, i) => (
        <div class="panel" role="tabpanel" id={`panel-${cat.id}`} aria-labelledby={`tab-${cat.id}`} tabindex={0} hidden={i !== 0}>
          <div class="panel__intro"><h3>{cat.titulo}</h3><p>{cat.intro}</p></div>
          <div class="machines">
            {cat.modelos.map((m) => (
              <MachineCard
                slug={m.id}
                nombre={m.data.nombre}
                marca={m.data.marca}
                ref={m.data.ref}
                img={m.data.img}
                chips={m.data.chips}
                feats={m.data.feats}
              />
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="callout reveal">
      <div>
        <h3>¿No encontrás el modelo que buscás?</h3>
        <p>Trabajamos otros tipos y modelos de máquinas. Consultanos sin compromiso.</p>
      </div>
      <div class="callout__actions">
        <a class="btn btn--primary btn--sm" href={waLink()} target="_blank" rel="noopener">Consultar por WhatsApp</a>
        <a class="btn btn--ghost btn--sm" href={`tel:${SITE.tel}`}>{SITE.telHumano}</a>
      </div>
    </div>
  </div>
</section>
