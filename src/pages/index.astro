---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Brands from '../components/home/Brands.astro';
import Nosotros from '../components/home/Nosotros.astro';
import CatalogoTeaser from '../components/home/CatalogoTeaser.astro';
import Servicios from '../components/home/Servicios.astro';
import Contacto from '../components/home/Contacto.astro';

const title = 'Casa Kira — Máquinas de coser y bordar industriales · Desde 1967';
const description =
  'Venta y reparación de máquinas de coser y bordar, industriales y familiares. Importador directo de Typical, Siruba, Yamata, Juki, Brother y Pegasus. Repuestos, hilados y accesorios. Servicio técnico propio en CABA desde 1967.';
---
<Base title={title} description={description}>
  <Hero />
  <Brands />
  <Nosotros />
  <CatalogoTeaser />
  <Servicios />
  <Contacto />
</Base>

<script>
  import '../scripts/enhance';
</script>
