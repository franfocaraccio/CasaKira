---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MachineCard from '../../components/MachineCard.astro';
import Icon from '../../components/Icon.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import { categoriaPorId } from '../../data/categorias';
import { SITE, waModelo } from '../../data/site';

export async function getStaticPaths() {
  const maquinas = await getCollection('maquinas');
  return maquinas.map((m) => ({ params: { slug: m.id }, props: { m, todas: maquinas } }));
}

type Props = { m: CollectionEntry<'maquinas'>; todas: CollectionEntry<'maquinas'>[] };
const { m, todas } = Astro.props as Props;
const d = m.data;
const cat = categoriaPorId(d.categoria)!;
const titulo = `${d.nombre} ${d.marca}`;

// Relacionados: hermanos de la misma categoría; si no hay, tres de otras.
const hermanos = todas
  .filter((o) => o.data.categoria === d.categoria && o.id !== m.id)
  .sort((a, b) => a.data.orden - b.data.orden);
const relacionados = hermanos.length ? hermanos : todas.filter((o) => o.id !== m.id).slice(0, 3);

const waHref = waModelo({ corto: cat.corto, marca: d.marca, ref: d.ref });
const imgAbs = `${SITE.dominio}/assets/maquinas/${d.img}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titulo,
  sku: d.ref,
  description: d.resumen,
  brand: { '@type': 'Brand', name: d.marca },
  category: cat.titulo,
  image: imgAbs,
  url: `${SITE.dominio}/maquinas/${m.id}/`,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'ARS',
    seller: { '@type': 'Organization', name: SITE.nombreLegal },
  },
};
---
<Base
  title={`${titulo} — Casa Kira`}
  description={`${d.resumen} Venta y servicio técnico en Casa Kira, Av. Forest 888, CABA.`}
  image={imgAbs}
  ogType="product"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="wrap">
    <nav aria-label="Migas de pan">
      <ol class="breadcrumb">
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo/">Catálogo</a></li>
        <li><a href={`/catalogo/?cat=${cat.id}`}>{cat.nombre}</a></li>
        <li><span aria-current="page">{d.marca}</span></li>
      </ol>
    </nav>

    <div class="pdp">
      <div>
        <div class="photo-panel">
          <img src={`/assets/maquinas/${d.img}`} alt={titulo} width="250" height="167" />
          <span class="photo-panel__tag">{cat.nombre} · {d.marca}</span>
        </div>
      </div>

      <div>
        <p class="pdp__brand">{d.marca}</p>
        <h1>{d.nombre}</h1>
        <p class="pdp__resumen">{d.resumen}</p>

        <div class="chips" style="margin-top:var(--s-5)">
          {d.chips.map((c) => <span class="chip">{c}</span>)}
        </div>

        <div class="pdp__cta">
          <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">
            <BrandIcon name="whatsapp" size={17} /> Consultar por WhatsApp
          </a>
          <a class="btn btn--ghost" href={`tel:${SITE.tel}`}>Llamar al {SITE.telCorto}</a>
        </div>

        <dl class="pdp__meta">
          <div><dt>Referencia</dt><dd class="mono">{d.ref}</dd></div>
          <div><dt>Categoría</dt><dd>{cat.nombre}</dd></div>
          <div><dt>Marca</dt><dd>{d.marca}</dd></div>
        </dl>
      </div>
    </div>

    <div class="pdp-detalle">
      <section>
        <h2>Características</h2>
        <ul class="feat-list" style="font-size:.9375rem">
          {d.feats.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      <section>
        <h2>Ficha técnica</h2>
        <table class="spec-table">
          <tbody>
            {d.specs.map((s) => <tr><th scope="row">{s.k}</th><td>{s.v}</td></tr>)}
          </tbody>
        </table>
      </section>
    </div>

    <section class="related">
      <div class="related__head">
        <h2>{hermanos.length ? `Otros modelos de ${cat.nombre.toLowerCase()}` : 'También te puede servir'}</h2>
        <a class="link-arrow" href="/catalogo/">Ver todo el catálogo <Icon name="arrow" size={15} /></a>
      </div>
      <div class="machines">
        {relacionados.map((o) => (
          <MachineCard
            slug={o.id}
            nombre={o.data.nombre}
            marca={o.data.marca}
            ref={o.data.ref}
            img={o.data.img}
            chips={o.data.chips}
            feats={o.data.feats}
            heading="h3"
          />
        ))}
      </div>
    </section>
  </div>

  <section class="cta-band">
    <div class="tech-grid" aria-hidden="true" style="mask-image:radial-gradient(ellipse 70% 90% at 80% 50%,#000 20%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 70% 90% at 80% 50%,#000 20%,transparent 100%)"></div>
    <div class="wrap cta-band__in">
      <div>
        <h2>¿Querés verla funcionando?</h2>
        <p>Pasá por Av. Forest 888 o escribinos: te asesoramos sin cargo sobre el modelo que mejor se adapta a tu producción.</p>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--ink" href={waHref} target="_blank" rel="noopener">Consultar por esta máquina</a>
        <a class="btn btn--ink-ghost" href="/contacto/">Ver datos de contacto</a>
      </div>
    </div>
  </section>
</Base>
