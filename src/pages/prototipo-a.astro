---
/**
 * PROTOTIPO A — Editorial industrial. Página de prueba, no enlazada desde el
 * sitio. Reusa el layout (nav y pie) pero todo lo demás es propio de acá.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { MARCAS, SITE } from '../data/site';
import { CATEGORIAS } from '../data/categorias';
import { getCollection } from 'astro:content';
import '../styles/proto-a.css';

const maquinas = await getCollection('maquinas');

// El título se parte en palabras para revelarlas de a una.
const titulo = ['Asesoramos', 'y', 'proveemos', 'a', 'la', 'industria', 'textil', 'desde'];

const stats = [
  { n: 60, suf: 'años', l: 'De trayectoria ininterrumpida equipando a la industria textil argentina', hero: true },
  { n: MARCAS.length, suf: 'marcas', l: 'Representadas como importador directo' },
  { n: 7, suf: 'tipos', l: 'De máquina en catálogo' },
  { n: 300, pre: '+', l: 'Colores en hilado para bordar' },
];

const tiles = [
  {
    n: '01', href: '/catalogo#maquinas', lg: true, ghost: '01',
    h: 'Máquinas de coser y bordar',
    p: 'Rectas, overlock, interlock, de poste, atracadoras, ojaladoras y cortadoras de tela. Industriales y familiares, de las principales marcas del mundo.',
    go: 'Ver máquinas',
    meta: `${CATEGORIAS.length} categorías · ${maquinas.length} modelos`,
  },
  { n: '02', href: '/catalogo#repuestos', ghost: '02', h: 'Accesorios y herramientas', p: 'Prensatelas, guías, cuchillas, bobinas y chapas. Tijeras, cortantes y pinzas especiales.', go: 'Ver accesorios' },
  { n: '03', href: '/catalogo#repuestos', ghost: '03', h: 'Repuestos e insumos', p: 'Repuestos originales e hilados 100% poliéster, con más de 300 colores.', go: 'Ver repuestos' },
];
---
<Base title="Prototipo A — Casa Kira" description="Prototipo de diseño A (editorial industrial). Página de prueba.">
  <meta name="robots" content="noindex,nofollow" slot="head" />

  <section class="pa-hero" id="pa-hero" data-hero>
    <div class="pa-dots" aria-hidden="true"></div>
    <div class="pa-glow" aria-hidden="true"></div>

    <div class="wrap pa-hero__in">
      <h1 class="pa-title">
        {titulo.map((w, i) => (
          <><span class="pa-w"><span style={`animation-delay:${120 + i * 70}ms`}>{w}</span></span>{' '}</>
        ))}
        <span class="pa-w"><em><span style={`animation-delay:${120 + titulo.length * 70}ms`}>1967.</span></em></span>
      </h1>

      <p class="pa-lead">
        Encuentre en nuestro sitio todo lo necesario para la industria textil.
        Venta y reparación de Máquinas de Coser y Bordar. Máquinas de Broches y de Cortar.
        Planchas. Hilos. Repuestos y accesorios originales.
      </p>

      <div class="pa-cta">
        <a class="btn btn--primary pa-shine" href="/catalogo">Ver catálogo <Icon name="arrow" size={17} /></a>
        <a class="btn btn--ghost" href="/contacto">Pedir presupuesto sin cargo</a>
      </div>

      <dl class="pa-stats">
        {stats.map((s) => (
          <div class={`pa-stat${s.hero ? ' pa-stat--hero' : ''}`} data-tile>
            <dt class="pa-stat__l">{s.l}</dt>
            <dd class="pa-stat__n" style="margin:0">
              {s.pre && <small style="margin:0 .06em 0 0">{s.pre}</small>}<span data-count={s.n}>{s.n}</span>{s.suf && <small>{s.suf}</small>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="pa-marquee" aria-label="Marcas que representamos">
    <div class="wrap"><p class="pa-marquee__head">Importador directo de máquinas y repuestos</p></div>
    <div class="pa-track">
      {[0, 1].map(() => MARCAS.map((m) => <span class="pa-brand">{m}</span>))}
    </div>
  </section>

  <section class="pa-section">
    <div class="wrap">
      <div class="pa-head pa-up">
        <p class="pa-eyebrow">Catálogo</p>
        <h2 class="pa-h2">Todo lo que el taller necesita, en un solo lugar.</h2>
      </div>

      <div class="pa-bento">
        {tiles.map((t) => (
          <a class={`pa-tile pa-up${t.lg ? ' pa-tile--lg' : ''}`} href={t.href} data-tile>
            <span class="pa-tile__ghost" aria-hidden="true">{t.ghost}</span>
            <span class="pa-tile__n">{t.n}</span>
            <h3>{t.h}</h3>
            <p>{t.p}</p>
            {t.meta && <span class="section-index" style="margin-top:var(--s-4)">{t.meta}</span>}
            <span class="pa-tile__go">{t.go} <Icon name="arrowUpRight" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pa-close">
    <div class="pa-close__grid" aria-hidden="true"></div>
    <div class="wrap pa-close__in">
      <div>
        <h2>¿Necesitás asesoramiento para tu taller?</h2>
        <p>Contanos qué producís y te recomendamos la máquina que mejor se adapta. Presupuestos sin cargo.</p>
      </div>
      <div class="pa-cta">
        <a class="btn btn--w" href="/contacto">Pedir presupuesto</a>
        <a class="btn btn--wg" href={`tel:${SITE.tel}`}>{SITE.telHumano}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Aparición al scrollear, contadores y spotlight. (El revelado del título es
  // animación de CSS, así que no depende de este script.)
  const ups = [...document.querySelectorAll<HTMLElement>('.pa-up')];
  let fired = false;
  const io = new IntersectionObserver(
    (entries, obs) => {
      fired = true;
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        (e.target as HTMLElement).dataset.in = 'true';
        obs.unobserve(e.target);
      });
    },
    { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
  );
  ups.forEach((el) => io.observe(el));
  // Salvavidas: si el observer nunca reporta, se muestra todo igual.
  setTimeout(() => {
    if (!fired) ups.forEach((el) => (el.dataset.in = 'true'));
  }, 1500);

  const cio = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        obs.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - t0) / 1800, 1);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    },
    { threshold: 0.6 }
  );
  document.querySelectorAll('[data-count]').forEach((n) => cio.observe(n));

  document.querySelectorAll<HTMLElement>('[data-tile]').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });
</script>
