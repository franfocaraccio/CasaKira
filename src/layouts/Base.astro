---
import '../styles/global.css';
import { SITE } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  ogType?: string;
}
const { title, description, image, canonical, ogType = 'website' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.dominio).href;
// Imagen de las previsualizaciones al compartir (WhatsApp, Facebook, X). Por defecto,
// la de marca: 1200x630, con el logo dentro del cuadrado central porque WhatsApp
// recorta la miniatura a un cuadrado. Las fichas de máquina pasan la suya por `image`.
const ogImage = image ?? `${SITE.dominio}/assets/og-casakira.jpg`;
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23C1272D'/%3E%3Ctext x='32' y='47' font-family='Arial Black,Impact,sans-serif' font-size='44' font-weight='900' fill='%23fff' text-anchor='middle'%3EK%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="es-AR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Casa Kira — Máquinas de coser y bordar" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Casa Kira" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={favicon} />
    <meta name="theme-color" content="#C1272D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Tema antes del primer pintado, para evitar el flash. Y marca .js: sin
         JavaScript el contenido igual se ve (las animaciones .reveal se apagan). -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('casakira-theme');
          document.documentElement.dataset.theme = t || 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
        document.documentElement.classList.add('js');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <Fab />

    <!-- Realce del nav al scrollear + menú mobile. Van en el layout para correr
         en TODAS las páginas (incluidas las fichas). El menú es HTML estático:
         no depende de la hidratación de ningún framework, así siempre abre. -->
    <script>
      const nav = document.getElementById('nav');
      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          if (nav) nav.dataset.scrolled = y > 8 ? 'true' : 'false';
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const burger = document.getElementById('nav-burger');
      const sheet = document.getElementById('sheet');
      if (burger && sheet) {
        const closeBtn = sheet.querySelector('[data-sheet-close]');
        const setOpen = (open: boolean) => {
          sheet.dataset.open = String(open);
          burger.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
          if (open) (sheet.querySelector('a, button') as HTMLElement | null)?.focus();
          else burger.focus();
        };
        burger.addEventListener('click', () => setOpen(true));
        closeBtn?.addEventListener('click', () => setOpen(false));
        sheet
          .querySelectorAll('.sheet__link, .sheet__foot a')
          .forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sheet.dataset.open === 'true') setOpen(false);
        });
      }
    </script>
  </body>
</html>
