# Leading slash anchors these to the repo root — without it, `maquinas/` would
# also ignore `assets/maquinas/`, which holds the product photos we DO track.

# Generated by `node build.js` — rebuilt on every deploy
/maquinas/
/sitemap.xml

# Generated by `node build-single-file.js` — ~1.7 MB build artifacts each,
# only meant for emailing a preview. Never commit them.
/casa-kira-prototipo.html
/casa-kira-ficha-ejemplo.html

# Astro
node_modules/
dist/
.astro/

# Legacy vanilla build artifacts (kept under legacy/ for reference)
/legacy/maquinas/
/legacy/sitemap.xml

.DS_Store
Thumbs.db
